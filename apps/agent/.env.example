# Base de données — DOIT pointer vers la MÊME instance PostgreSQL que le
# backend principal (apps/api/.env DATABASE_URL). L'agent lit les tables
# existantes (feedbacks, analyses_ia, qr_codes, agences, organisations,
# utilisateurs, demandes_contact) et écrit uniquement dans actions_agent.
DATABASE_URL=postgresql://postgres:password@localhost:5432/ikanai

# JWT — DOIVENT être IDENTIQUES à SECRET_KEY/ALGORITHM du backend principal.
# L'agent ne fait que VÉRIFIER les tokens émis par le backend principal au
# login, il n'émet jamais de token lui-même (pas de /login ici).
SECRET_KEY=votre-cle-secrete-tres-longue-et-aleatoire-min-32-chars
ALGORITHM=HS256

# Secret partagé pour le webhook POST /webhook/analyse-complete, appelé par
# le backend principal. DOIT être IDENTIQUE à WEBHOOK_SECRET côté apps/api.
WEBHOOK_SECRET=un-secret-partage-long-et-aleatoire-a-generer

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001
DEBUG=true

# CORS (si le dashboard appelle ce service directement plutôt que via un
# proxy du backend principal)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4321

# Mistral — génération de texte (réponses Q&A, brouillons d'action)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Hugging Face — réservé. Le classifieur d'intention actuel (intent_classifier.py)
# est un moteur à mots-clés déterministe et n'appelle PAS l'API HF ; cette clé
# est conservée pour une éventuelle évolution future (voir README.md).
HF_API_KEY=

# WhatsApp Business (Meta Cloud API) — envoi déclenché à la validation d'un
# brouillon de type REPONSE_CLIENT, uniquement si le client a laissé un numéro.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=suivi_reclamation_client
WHATSAPP_TEMPLATE_LANG=fr
